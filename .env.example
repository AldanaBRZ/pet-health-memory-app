NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Optional comma-separated tester allowlist for early Vercel builds.
# This is visible in browser bundles and should be treated as a UX gate, not a security boundary.
# Leave blank to allow any Supabase-authenticated email through the app UI.
NEXT_PUBLIC_ALLOWED_TESTER_EMAILS=

# Optional server-side allowlist for AI summaries. This is not exposed to the browser.
# Leave blank to allow any signed-in Supabase user to use AI summaries when OPENAI_API_KEY is set.
ALLOWED_TESTER_EMAILS=

# Optional. If omitted, the app uses local deterministic summaries.
# AI summaries require a signed-in user and explicit in-app opt-in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
