{
  "name": "pet-health-memory-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium --project=mobile-webkit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "1.31.0",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.2",
    "eslint": "10.8.1",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
